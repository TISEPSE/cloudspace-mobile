{
  "name": "cloudspace-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "cap:sync": "vite build && npx cap sync android",
    "cap:open": "vite build && npx cap sync android && npx cap open android",
    "android:debug": "vite build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "vite build && npx cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
